# LangExtract API Key (required)
# Get your API key from: https://langextract.ai
LANGEXTRACT_API_KEY=your_api_key_here

# Optional: Gemini API Key
# If not set, LANGEXTRACT_API_KEY will be used for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Neo4j Aura connection (enables "Push to Neo4j" and the in-app graph view)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Optional: BioPortal API key (enables "Find SNOMED code" lookup on the Diagnoses panel)
# Get a free key from: https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=your_bioportal_api_key_here
